# Copy to backend/.env (used by npm run start:dev)
# Start MySQL yourself first. Database: loop_db

PORT=3000
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=loop_db
DB_SYNC=true

JWT_SECRET=project-loop-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Must be localhost when backend runs with npm (not Docker)
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=myverylongsecretkey12345678901234567890

# MeetNote integration (Loop calls MeetNote HTTP APIs; MeetNote owns transcription/AI)
MEETNOTE_BASE_URL=http://localhost:8000
MEETNOTE_SERVICE_EMAIL=sakshi.integration@example.com
MEETNOTE_SERVICE_PASSWORD=meetnote-pass
# MEETNOTE_SERVICE_TOKEN=your_static_bearer_token_if_available
MEETNOTE_POLL_INTERVAL_MS=5000
MEETNOTE_MAX_POLL_ATTEMPTS=120
