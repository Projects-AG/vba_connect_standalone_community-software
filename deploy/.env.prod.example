# Production secrets for Hostinger KVM2 (Phase 1 — IP launch).
# Copy to deploy/.env.prod and fill in real values:
#   cp deploy/.env.prod.example deploy/.env.prod
#
# NEVER commit deploy/.env.prod

# Public IP of the VPS (no scheme, no trailing slash)
PUBLIC_HOST=YOUR_VPS_PUBLIC_IP

# Host port for nginx (default 80)
HTTP_PORT=80

# Browser → LiveKit (must be reachable from users' browsers)
VITE_LIVEKIT_URL=ws://YOUR_VPS_PUBLIC_IP:7880

# Empty = same-origin API via nginx proxy (recommended)
VITE_API_URL=

# CORS for Nest (browser origin)
CORS_ORIGINS=http://YOUR_VPS_PUBLIC_IP

# Backend ↔ LiveKit (Docker network)
LIVEKIT_HOST=http://livekit:7880

# Must match keys in deploy/livekit.prod.yaml
# Generate: openssl rand -hex 16  /  openssl rand -hex 32
LIVEKIT_API_KEY=CHANGE_ME_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LONG_SECRET_AT_LEAST_32_CHARS

# Auth
JWT_SECRET=CHANGE_ME_JWT_SECRET_LONG_RANDOM
JWT_EXPIRES_IN=7d

# MySQL
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_USER=loop
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=loop_db
# true on first boot; set false after schema is stable
DB_SYNC=true

# Optional image tags
BACKEND_IMAGE=loop-backend:prod
FRONTEND_IMAGE=loop-web:prod
